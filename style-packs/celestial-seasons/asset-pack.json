{
  "schema": "himind.asset-pack.v1",
  "id": "celestial-seasons",
  "version": "1.0.0",
  "name": "天体四季科普",
  "description": "three.js PBR 天体运动科普模板：公转、地轴倾角、太阳高度与南北半球季节，含 NASA 地球昼夜/云层/法线/高光贴图。",
  "license": "MIT",
  "attribution": "HiMind original celestial-seasons composition; three.js (MIT) is an npm dependency; Earth day/night/cloud/normal/specular textures are from NASA Visible Earth via the three.js examples texture set (NASA imagery is public domain).",
  "resources": [
    {
      "id": "template",
      "type": "template",
      "path": "template",
      "role": "render-template",
      "runtime": "browser-code",
      "entry": "render.mjs",
      "format": "directory"
    },
    {
      "id": "preview",
      "type": "image",
      "path": "preview/sheet.jpg",
      "role": "preview",
      "mime": "image/jpeg"
    },
    {
      "id": "storyboard",
      "type": "docs",
      "path": "template/STORYBOARD.md",
      "role": "storyboard",
      "mime": "text/markdown"
    },
    {
      "id": "preview_loop",
      "type": "image",
      "path": "preview/loop.webp",
      "role": "preview_loop",
      "mime": "image/webp"
    }
  ],
  "entrypoints": [
    {
      "id": "render",
      "resource": "template",
      "runtime": "browser-code",
      "entry": "render.mjs",
      "inputs": [
        "brief.json",
        "data.json"
      ],
      "outputs": [
        "video.mp4",
        "video-web.mp4"
      ]
    }
  ],
  "provenance": {
    "source": "https://github.com/mrdoob/three.js",
    "commit": "three@0.160.0",
    "license": "MIT",
    "adapted_files": [
      "three.module.js as npm dependency",
      "earth_atmos_2048.jpg",
      "earth_lights_2048.png",
      "earth_clouds_1024.png",
      "earth_specular_2048.jpg",
      "earth_normal_2048.jpg"
    ],
    "changes": [
      "astronomy explainer composition",
      "PBR Earth shader with day/night, clouds, ocean specular, normal map and atmosphere"
    ]
  },
  "permissions": {
    "filesystem": "workspace",
    "process": [
      "node",
      "chrome",
      "ffmpeg"
    ],
    "network": {
      "mode": "none",
      "allow": []
    }
  },
  "quality": {
    "smoke": "preview/sheet.jpg",
    "determinism": true
  },
  "consumers": [
    "com.himind.media-workbench"
  ],
  "tags": [
    "video",
    "style",
    "3d",
    "threejs",
    "astronomy",
    "science",
    "education",
    "space"
  ]
}


