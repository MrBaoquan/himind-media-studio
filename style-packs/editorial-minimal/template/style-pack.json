{
  "schema": "himind.video.style-pack.v1",
  "id": "editorial-minimal",
  "version": "1.0.0",
  "name": "极简编辑",
  "description": "暖白纸张、衬线大标题、细线分层、编辑式数字排版。",
  "renderer": "browser-code",
  "entry": "render.mjs",
  "video_out": "out/video.mp4",
  "duration_seconds": 10,
  "preview": {
    "sheet_out": "out/check/sheet.jpg",
    "strip_out": "out/check/strip.jpg",
    "stills_out": "out/stills"
  },
  "license": "MIT",
  "network": {
    "mode": "none",
    "allow": []
  },
  "delivery": {
    "web": true,
    "web_width": 1280,
    "web_crf": 23,
    "max_master_mb": 50
  },
  "attribution": "HiMind original editorial-minimal style pack"
}
