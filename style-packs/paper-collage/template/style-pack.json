    "strip_out": "out/check/strip.jpg",
    "stills_out": "out/stills"
  },
  "license": "MIT",
  "network": {
    "mode": "none",
    "allow": []
  },
  "delivery": {
    "web": true,
    "web_width": 1280,
    "web_crf": 23,
    "max_master_mb": 50
  },
  "attribution": "HiMind original paper-collage style pack",
  "quality": {
    "text_audit": {
      "enabled": true,
      "page": "reel/index.html",
