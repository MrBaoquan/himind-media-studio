{
  "schema": "himind.asset-pack.v1",
  "id": "3d-product-reel",
  "version": "1.0.0",
  "name": "3D 产品展示",
  "description": "three.js 工作室产品展示，金属材质、环形光效、浮动卖点与电影感镜头。",
  "license": "MIT",
  "attribution": "HiMind original 3d-product-reel style pack; three.js (MIT) is an npm dependency.",
  "resources": [
    {
      "id": "template",
      "type": "template",
      "path": "template",
      "role": "render-template",
      "runtime": "browser-code",
      "entry": "render.mjs",
      "format": "directory"
    },
    {
      "id": "preview",
      "type": "image",
      "path": "preview/sheet.jpg",
      "role": "preview",
      "mime": "image/jpeg"
    },
    {
      "id": "storyboard",
      "type": "docs",
      "path": "template/STORYBOARD.md",
      "role": "storyboard",
      "mime": "text/markdown"
    },
    {
      "id": "preview_loop",
      "type": "image",
      "path": "preview/loop.webp",
      "role": "preview_loop",
      "mime": "image/webp"
    }
  ],
  "entrypoints": [
    {
      "id": "render",
      "resource": "template",
      "runtime": "browser-code",
      "entry": "render.mjs",
      "inputs": [
        "brief.json",
        "data.json"
      ],
      "outputs": [
        "video.mp4",
        "video-web.mp4"
      ]
    }
  ],
  "provenance": {
    "source": "https://github.com/mrdoob/three.js",
    "commit": "three@0.160.0",
    "license": "MIT",
    "adapted_files": [
      "three.module.js as npm dependency"
    ],
    "changes": [
      "new three.js composition"
    ]
  },
  "permissions": {
    "filesystem": "workspace",
    "process": [
      "node",
      "chrome",
      "ffmpeg"
    ],
    "network": {
      "mode": "none",
      "allow": []
    }
  },
  "quality": {
    "smoke": "preview/sheet.jpg",
    "determinism": true
  },
  "consumers": [
    "com.himind.media-workbench"
  ],
  "tags": [
    "video",
    "style",
    "3d",
    "threejs",
    "product",
    "studio"
  ]
}
