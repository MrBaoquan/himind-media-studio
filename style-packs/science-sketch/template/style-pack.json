{
  "schema": "himind.video.style-pack.v1",
  "id": "science-sketch",
  "version": "0.1.1",
  "name": "科学手绘",
  "description": "手绘线条、淡彩、光谱、散射与对比图解组成的科学解释风格。",
  "renderer": "browser-code",
  "entry": "render.mjs",
  "video_out": "out/video.mp4",
  "duration_seconds": 45,
  "preview": {
    "sheet_out": "out/check/sheet.jpg",
    "strip_out": "out/check/strip.jpg",
    "stills_out": "out/stills"
  },
  "license": "MIT",
  "network": {
    "mode": "none",
    "allow": []
  },
  "delivery": {
    "web": true,
    "web_width": 1280,
    "web_crf": 23,
    "max_master_mb": 50
  },
  "attribution": "HiMind original science-sketch style pack; Rough.js 4.6.6 (MIT) vendored locally.",
  "quality": {
    "text_audit": {
      "enabled": true,
      "page": "reel/index.html",
      "times": "4,9,18,27,36,42"
    },
    "banding_gate": false
  },
  "runtime": {
    "max_workers": 1
  }
}
