    "changes":["science explainer scene grammar","watercolour wash","hand-drawn diagram primitives"]
  },
  "permissions": {"filesystem":"workspace","process":["node","chrome","ffmpeg"],"network":{"mode":"none","allow":[]}},
  "quality": {"smoke":"preview/sheet.jpg","determinism":true},
  "consumers": ["com.himind.media-workbench"],
  "tags": ["video","style","science","explainer","hand-drawn","education","diagram"]
