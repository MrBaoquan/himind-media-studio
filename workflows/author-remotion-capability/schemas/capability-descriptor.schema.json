{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/capability-descriptor.schema.json",
  "title": "HiMind Video Capability Descriptor",
  "description": "一个可复用视觉能力的完整声明：Shot、Technique、Contract、Template、Fixture 与证据。",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "status",
    "structure",
    "summary",
    "reuse_for",
    "template",
    "sources",
    "fixture",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "himind.video.capability-descriptor.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["candidate", "validated", "ready", "deprecated"]
    },
    "structure": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reuse_for": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "template": {
      "type": "object",
      "required": ["id", "version", "composition", "data_contract"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "composition": {"type": "string"},
        "data_contract": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": ["shot", "registry"],
      "properties": {
        "shot": {"type": "string"},
        "registry": {"type": "string"},
        "techniques": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": ["manifest_id", "recipe", "frames"],
      "properties": {
        "manifest_id": {"type": "string"},
        "recipe": {"type": "string"},
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "object",
      "description": "可选的成片与门禁证据，仅用于说明，不参与文件存在性审计。",
      "additionalProperties": true
    },
    "authoring": {
      "type": "object",
      "properties": {
        "proposal_schema": {"type": "string"},
        "skill": {"type": "string"},
        "workflow": {"type": "string"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
