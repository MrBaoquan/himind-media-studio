  "title": "天空为什么是蓝色的？",
  "brief": {
    "title": "天空为什么是蓝色的？",
    "topic": "瑞利散射",
    "goal": "用反直觉问题解释天空呈蓝色的物理机制，并纠正常见误解",
    "audience": "泛知识用户 / 中学生",
    "platform": "douyin",
    "duration_seconds": 45,
    "tone": "好奇、克制、可视化解释",
    "constraints": [
      "不能用海水反射解释天空颜色",
      "必须区分散射与反射",
      "必须给出来源"
    ],
    "success_criteria": [
      "观众能说出蓝光被空气散射",
      "能解释日落为什么偏红",
      "没有事实性错误",
      "能解释紫光散射更强但天空不呈紫色的原因"
    ],
    "source": "NASA Space Place / NOAA JetStream（完整 URL 见 research.sources）"
  },
  "research": {
    "mode": "required",
    "sources": [
      {
        "id": "s1",
        "publisher": "NASA Space Place",
        "title": "Why Is the Sky Blue?",
        "url": "https://spaceplace.nasa.gov/blue-sky/en/"
      },
      {
        "id": "s2",
        "publisher": "NOAA JetStream",
        "title": "The Atmosphere",
        "url": "https://www.noaa.gov/jetstream/atmosphere"
      }
    ],
    "claims": [
      {
        "id": "c1",
        "text": "太阳光包含多种可见光波长",
        "evidence_refs": [
          "s1"
        ],
        "confidence": "high"
      },
      {
        "id": "c2",
        "text": "瑞利散射强度近似与波长四次方成反比，短波长散射更强",
        "evidence_refs": [
          "s1",
          "s2"
        ],
        "confidence": "high"
      },
      {
        "id": "c3",
        "text": "日落时光线穿过更厚的大气层，蓝光被散掉更多",
        "evidence_refs": [
          "s1"
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "天空的蓝色不是海洋反射造成的",
        "evidence_refs": [
          "s1"
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "紫光比蓝光散射更强，但人眼对蓝光更敏感，且太阳光谱中紫光较少",
        "evidence_refs": [
          "s1"
        ],
        "confidence": "high"
      }
    ],
    "uncertainties": [
      "45 秒版本不展开臭氧吸收、太阳高度角与观测者纬度的细节"
    ]
  },
  "script": {
    "logline": "从一个反直觉问题出发，用光、空气分子和日落对比解释天空的蓝色。",
    "structure": "hook -> sunlight -> scattering -> observer -> sunset -> takeaway",
    "beats": [
      {
        "id": "b1",
        "purpose": "hook",
        "duration_seconds": 5,
        "narration": "天空明明是空的，为什么抬头却是蓝色？",
        "on_screen_text": "天空为什么是蓝色的？",
        "visual_intent": "白板问号、淡彩天空、太阳"
      },
      {
        "id": "b2",
        "purpose": "setup",
        "duration_seconds": 7,
        "narration": "阳光看起来是白色，其实包含所有颜色。",
        "on_screen_text": "白光 = 可见光谱",
        "visual_intent": "棱镜分出七色光"
      },
      {
        "id": "b3",
        "purpose": "mechanism",
        "duration_seconds": 11,
        "narration": "空气分子会把短波长的蓝光散射到四面八方，强度大约与波长的四次方成反比。",
        "on_screen_text": "蓝光更容易被散射",
        "visual_intent": "空气分子与蓝色波浪箭头"
      },
      {
        "id": "b4",
        "purpose": "proof",
        "duration_seconds": 8,
        "narration": "所以无论你看向天空哪里，都有蓝光进入眼睛。紫光散射更强，但人眼对蓝更敏感。",
        "on_screen_text": "整片天空都在发蓝",
        "visual_intent": "观察者、来自天空各处的箭头，并标注紫光与视觉敏感度"
      },
      {
        "id": "b5",
        "purpose": "twist",
        "duration_seconds": 9,
        "narration": "日落时光线穿过更厚的大气层，蓝光先被散掉，只剩红橙。",
        "on_screen_text": "傍晚为什么变红？",
        "visual_intent": "白天/日落分屏与长路径"
      },
      {
        "id": "b6",
        "purpose": "conclusion",
        "duration_seconds": 5,
        "narration": "你看到的蓝，是空气散射后的阳光。",
        "on_screen_text": "你看到的蓝，是空气散射后的阳光。",
        "visual_intent": "结论卡与来源"
      }
    ]
  },
