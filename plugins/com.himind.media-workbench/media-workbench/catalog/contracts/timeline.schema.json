{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline data contract",
  "type": "object",
  "required": ["events"],
  "properties": {
    "unit": {"type": "string"},
    "title": {"type": "string"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "title"],
        "properties": {
          "year": {"type": "integer"},
          "title": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
