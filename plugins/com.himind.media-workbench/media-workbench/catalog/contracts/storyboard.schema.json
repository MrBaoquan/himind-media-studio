{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard data contract",
  "type": "object",
  "required": ["storyboard"],
  "properties": {
    "transition_frames": {"type": "integer", "minimum": 0, "maximum": 30},
    "storyboard": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot", "duration_seconds"],
        "properties": {
          "shot": {"type": "string", "description": "镜头 id：big-number / compare / quote / bar-race / timeline / choropleth / composition / flow / route-growth"},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 60},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "data": {"type": "object"}
        }
      }
    }
  }
}


