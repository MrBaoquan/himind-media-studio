{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bar-race data contract",
  "type": "object",
  "required": ["items", "years"],
  "properties": {
    "unit": {"type": "string"},
    "title": {"type": "string"},
    "years": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}}
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "valueByYear"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "color": {"type": "string"},
          "valueByYear": {"type": "object", "description": "年份字符串 → 数值"}
        }
      }
    }
  }
}
