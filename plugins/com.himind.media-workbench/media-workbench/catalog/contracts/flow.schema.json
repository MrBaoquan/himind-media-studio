{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flow data contract",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "conclusion": {"type": "string"}
  },
  "additionalProperties": true
}
