{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/asset-pack.schema.json",
  "title": "HiMind Asset Pack",
  "type": "object",
  "required": ["schema", "id", "version", "name", "resources"],
  "properties": {
    "schema": {"type": "string", "const": "himind.asset-pack.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "license": {"type": "string"},
    "attribution": {"type": "string"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "path"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "path": {"type": "string"},
          "format": {"type": "string"},
          "mime": {"type": "string"},
          "role": {"type": "string"},
          "runtime": {"type": "string"},
          "entry": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "resource", "runtime", "entry"],
        "properties": {
          "id": {"type": "string"},
          "resource": {"type": "string"},
          "runtime": {"type": "string"},
          "entry": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "commit": {"type": "string"},
        "license": {"type": "string"},
        "adapted_files": {"type": "array", "items": {"type": "string"}},
        "changes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "permissions": {"type": "object"},
    "quality": {"type": "object"},
    "consumers": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
