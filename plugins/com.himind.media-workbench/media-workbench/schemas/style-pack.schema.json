{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/style-pack.schema.json",
  "title": "HiMind Browser-Code Style Pack",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "renderer",
    "entry"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "himind.video.style-pack.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "renderer": {
      "type": "string",
      "const": "browser-code"
    },
    "entry": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 300
    },
    "video_out": {
      "type": "string"
    },
    "preview": {
      "type": "object",
      "properties": {
        "sheet_out": {
          "type": "string"
        },
        "strip_out": {
          "type": "string"
        },
        "stills_out": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "trust": {
      "type": "string",
      "enum": [
        "signed",
        "local"
      ]
    },
    "network": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "declared",
            "full"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "web": {
          "type": "boolean"
        },
        "web_width": {
          "type": "integer",
          "minimum": 160,
          "maximum": 2160
        },
        "web_crf": {
          "type": "integer",
          "minimum": 18,
          "maximum": 32
        },
        "max_master_mb": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "banding_gate": {
          "type": "boolean"
        },
        "text_audit": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "page": {
              "type": "string"
            },
            "times": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "max_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
