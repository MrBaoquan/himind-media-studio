{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/plan.json",
  "title": "HiMind Video Plan",
  "type": "object",
  "required": ["version", "brief", "narrative", "storyboard", "presentation"],
  "properties": {
    "version": {"type": "string", "const": "himind.video.plan.v1"},
    "brief": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": {"type": "string"},
        "audience": {"type": "string"},
        "platform": {"type": "string"},
        "duration_seconds": {"type": "number", "minimum": 1, "maximum": 300},
        "tone": {"type": "string"},
        "must_include": {"type": "array", "items": {"type": "string"}},
        "must_avoid": {"type": "array", "items": {"type": "string"}},
        "data_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "required": ["thesis", "structure"],
      "properties": {
        "thesis": {"type": "string"},
        "structure": {"type": "string"},
        "key_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim"],
            "properties": {
              "claim": {"type": "string"},
              "evidence_ref": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "required_data": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "risk_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "storyboard": {
      "type": "object",
      "required": ["shots"],
      "properties": {
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["shot", "duration_seconds"],
            "properties": {
              "shot": {"type": "string"},
              "role": {"type": "string"},
              "duration_seconds": {"type": "number", "minimum": 1, "maximum": 60},
              "data_binding": {"type": "string"},
              "style_overrides": {"type": "object"},
              "transition": {"type": "string"},
              "rationale": {"type": "string"},
              "title": {"type": "string"},
              "subtitle": {"type": "string"},
              "data": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "source": {"type": "string"},
        "style_id": {"type": "string"},
        "transition_frames": {"type": "integer", "minimum": 0, "maximum": 60}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
