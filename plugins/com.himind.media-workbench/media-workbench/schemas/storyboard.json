{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/storyboard.json",
  "title": "HiMind Storyboard Plan",
  "type": "object",
  "required": ["version", "shots"],
  "properties": {
    "version": {"type": "string", "const": "himind.video.storyboard.v1"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["shot", "duration_seconds"],
        "properties": {
          "shot": {"type": "string"},
          "role": {"type": "string"},
          "duration_seconds": {"type": "number", "minimum": 1, "maximum": 60},
          "data_binding": {"type": "string"},
          "style_overrides": {"type": "object"},
          "transition": {"type": "string"},
          "rationale": {"type": "string"},
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "data": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
